"""
8
0 1
1 0
1 1
1 2
2 1
2 2
3 1
3 2
"""


board = []
for x in range(1100):
    board.append([0]*1100)
n = int(input())

def sno(x,y):
    return board[x][y-1] + board[x][y+1]+ board[x+1][y]+board[x-1][y]
ans = 0
for x in range(n):
    a,b = map(int, input().split())
    a+=50
    b+=50
    board[a][b] = 1
    
    if board[a][b-1] == 1 and sno(a,b-1) == 3:
        ans +=1
    if board[a][b-1] == 1 and sno(a,b-1) == 4:
        ans -=1

    if board[a][b+1] == 1 and sno(a,b+1) == 3:
        ans +=1
    if board[a][b+1] == 1 and sno(a,b+1) == 4:
        ans -=1

    if board[a-1][b] == 1 and sno(a-1,b) == 3:
        ans +=1
    if board[a-1][b] == 1 and sno(a-1,b) == 4:
        ans -=1

    if board[a+1][b] == 1 and sno(a+1,b) == 3:
        ans +=1
    if board[a+1][b] == 1 and sno(a+1,b) == 4:
        ans -=1

    if sno(a,b) == 3:
        ans +=1

    print(ans)




    
