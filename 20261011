"""
8
0 1
1 0
1 1
1 2
2 1
2 2
3 1
3 2
"""
n = int(input())
x = []
y = []
for z in range(n):
    tempx, tempy = map(int, input().split())
    x.append(tempx, -1, n)
    y.append(tempy, -1, n)
x.sort()
y.sort()

for m in range(n-1):
    if abs(x[m][0]-x[m+1][0]) == 1:
        x[m][1] = True

for l in range(n-1):
    if abs(y[l][0]-y[l+1][0]) == 1:
        y[l][1] = True
    
