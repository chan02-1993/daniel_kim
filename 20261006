import time
import math
import random
import turtle
turtle.tracer(0,0)
screen = turtle.Screen()

class circle:

    def __init__(self):
        self.t=turtle.Turtle()
        self.t.ht()
        self.t.up()
        self.t.speed(0)

        self.dx = 30
        self.dy = 30

tlist=[]
n=1
for x in range(n):
    t=circle()
    t.dx = random.randint(-20,20)
    t.dy = random.randint(-20,20)
    tlist.append(t)


def move(t,dt):
    tt = t.t
    tt.clear()
    pos = tt.pos()
    posx = pos[0]
    posy = pos[1]
    tt.goto(posx+t.dx*dt, posy+t.dy*dt)
    tt.dot(10)


key_w = False
def wpress():
    global key_w
    key_w = True
def wrelease():
    global key_w
    key_w = False

screen.onkeypress(wpress, "w")
screen.onkeyrelease(wrelease, "w")


key_a = False
def apress():
    global key_a
    key_a = True
def arelease():
    global key_a
    key_a = False

screen.onkeypress(apress, "a")
screen.onkeyrelease(arelease, "a")


key_s = False
def spress():
    global key_s
    key_s = True
def srelease():
    global key_s
    key_s = False

screen.onkeypress(spress, "s")
screen.onkeyrelease(srelease, "s")


key_d = False
def dpress():
    global key_d
    key_d = True
def drelease():
    global key_d
    key_d = False

screen.onkeypress(dpress, "d")
screen.onkeyrelease(drelease, "d")



screen.listen()
# 5. 이벤트 루프 유지




passed_time = 0
fps = 60
dt = 1/fps
while True:
    start = time.perf_counter()

    for x in range(len(tlist)):
        move(tlist[x],dt)

    if key_w == True:
        tlist[0].dy += 150*dt

    if key_a == True:
        tlist[0].dx -= 150*dt

    if key_s == True:
        tlist[0].dy -= 150*dt

    if key_d == True:
        tlist[0].dx += 150*dt
    
        
    turtle.update()

    elapsed = time.perf_counter() - start
    time.sleep(max(0, dt - elapsed))
    passed_time+=dt


screen.mainloop()




